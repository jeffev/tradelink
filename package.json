{
  "name": "tradelink-monorepo",
  "version": "1.0.0",
  "description": "Trading application for strategy backtesting and trade management",
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "dev:all": "docker-compose up -d redis && concurrently --names \"BACKEND,WORKER,FRONTEND\" --prefix-colors \"blue,yellow,green\" \"npm run dev:backend\" \"npm run dev:worker\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "dev:backend": "npm run start:dev --workspace=apps/backend",
    "dev:worker": "cd apps/backtesting-worker && uvicorn main:app --reload --port 8000",
    "dev": "npm run dev:frontend",
    "build": "npm run build --workspace=apps/frontend && npm run build --workspace=apps/backend",
    "test": "npm run test --workspace=apps/backend",
    "lint": "npm run lint --workspace=apps/frontend",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:build": "docker-compose up --build"
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "2.5.0"
    },
    "@nestjs/swagger": {
      "js-yaml": "^5.5.0"
    },
    "tar": "^7.5.22"
  }
}
